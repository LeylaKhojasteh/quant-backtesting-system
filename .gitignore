# Virtual environment (machine specific)
.venv/

# Large read-only source tick data
data/

# Archives
*.zip
*.rar

# Python / notebook caches
__pycache__/
*.pyc
.ipynb_checkpoints/

# Test build artifacts
.test-build/

# Generated research runs (local archive storage, not source).
# Each run directory holds config.json, result.json, trades.csv,
# equity.csv, report.html and strategy snapshots. These are
# reproducible outputs of `python -m src.run_backtest`, not inputs,
# and may be large — regenerate locally instead of committing them.
# The committed exception is tests/fixtures/ (small deterministic
# reference runs used by automated tests).
runs/
!runs/.gitkeep

# Dev server logs
.qbl-dev*.log
.qbl-bridge.log

# Derived data engine cache (Parquet tick store). Rebuildable/disposable,
# never committed — regenerate with `python -m src.data_engine build`.
cache/

# Frontend build output / generated types (rebuildable, machine specific)
.next/
dist/
next-env.d.ts
